{
  "manifest_version": 3,
  "name": "Codeforces Peak Analyzer",
  "version": "1.3",
  "description": "Plots your daily max-rated problem solves against your rating trajectory, highlighting your peak.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://codeforces.com/*",
    "*://*.codeforces.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/profile/*",
        "*://*.codeforces.com/profile/*"
      ],
      "js": [
        "lib/chart.umd.min.js",
        "lib/hammer.min.js",
        "lib/chartjs-plugin-zoom.min.js",
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cf-peak-analyzer@mysteriousbits.github.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
